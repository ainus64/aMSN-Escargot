	<main>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/DBusStateChanger/DBusStateChanger.tcl</main>
	<plugininfo>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/DBusStateChanger/plugininfo.xml</plugininfo>
		<lang>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/DBusStateChanger/lang/lang$langcode</lang>
