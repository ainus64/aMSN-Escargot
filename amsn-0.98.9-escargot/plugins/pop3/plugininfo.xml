<?xml version="1.0"?>
<plugin>
	<name>pop3</name>
	<author>Arieh Schneier & Youness Alaoui</author>
	<description>Plugin to check POP3 accounts in aMSN in the same way as hotmail ones.</description>
	<description_es>Plugin para comprobar las cuentas POP3 en aMSN de la misma forma que las de hotmail.</description_es>
	<description_fr>Ce plugin vous permet d'afficher vos comptes mails (par pop3) comme s'ils étaient sur hotmail.</description_fr>
	<amsn_version>0.95</amsn_version>
	<plugin_version>2.5</plugin_version>
	<plugin_file>pop3.tcl</plugin_file>
	<plugin_namespace>pop3</plugin_namespace>
	<init_procedure>Init</init_procedure>
	<deinit_procedure>DeInit</deinit_procedure>
	<cvs_version>12016</cvs_version>

	<file>
		<path>pixmaps/pop3_mailpic.gif</path>
		<version>4135</version>
	</file>
	<lang>
		<langcode>en</langcode>
		<version>11345</version>
	</lang>
	<lang>
		<langcode>es</langcode>
		<version>11348</version>
	</lang>

	<URL>
	<main>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/pop3/pop3.tcl</main>
	<plugininfo>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/pop3/plugininfo.xml</plugininfo>
		<lang>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/pop3/lang/lang$langcode</lang>
		<file>https://github.com/ainus64/aMSN-Escargot/autoupdater/plugins/pop3/$file</file>
	</URL>

</plugin>
